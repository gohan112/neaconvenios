# NeaEvento para Google Cloud Run (la cuenta Blaze de Firebase es la misma).
#
#   gcloud run deploy ...   (mira deploy/nube.sh, que lo hace todo)
#
# En la nube el disco del contenedor es de usar y tirar, así que la base de
# datos se replica a un bucket de Google Cloud Storage con Litestream: al
# arrancar se restaura la última copia y a partir de ahí cada cambio viaja al
# bucket en segundos. Un solo contenedor a la vez (SQLite escribe uno).
FROM python:3.12-slim

ARG LITESTREAM=0.3.13
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && curl -fsSL "https://github.com/benbjohnson/litestream/releases/download/v${LITESTREAM}/litestream-v${LITESTREAM}-linux-amd64.tar.gz" \
    -o /tmp/litestream.tgz \
 && tar -C /usr/local/bin -xzf /tmp/litestream.tgz litestream \
 && rm /tmp/litestream.tgz \
 && apt-get purge -y curl && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY *.py ./
COPY assets/ ./assets/
COPY deploy/litestream.yml /etc/litestream.yml
COPY deploy/arranque_nube.sh /arranque.sh
RUN chmod +x /arranque.sh

ENV EVENTO_DB_PATH=/data/evento.db \
    TZ=Europe/Madrid \
    PORT=8080
EXPOSE 8080

CMD ["/arranque.sh"]
